# Firebase Configuration
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=unidealz-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=unidealz-prod
VITE_FIREBASE_STORAGE_BUCKET=unidealz-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:website
VITE_FIREBASE_MEASUREMENT_ID=G-WEBSITE

# App Check (reCAPTCHA v3 site key; optional for emulators)
VITE_RECAPTCHA_SITE_KEY=demo-recaptcha-site-key

# Development (set to true for emulators)
VITE_USE_EMULATORS=true

# Dashboard app URL for login/signup links
VITE_DASHBOARD_URL=http://localhost:5174
