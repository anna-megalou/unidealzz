SUPABASE_URL=https://your-project.supabase.co
# service_role key from Supabase Dashboard → Project Settings → API (NOT the anon/public key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: import auth users from CSV instead of Supabase Admin API
# AUTH_USERS_SOURCE=csv
# CSV_AUTH_USERS=/path/to/auth_users-export.csv
FIREBASE_PROJECT_ID=unidealz-ad93f
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# USE_FIREBASE_EMULATOR=true
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
DRY_RUN=false
MIGRATE_BATCH_SIZE=400
FIREBASE_EXPERIENCE_BUCKET=experience-images
SUPABASE_EXPERIENCE_BUCKET=experience-images
